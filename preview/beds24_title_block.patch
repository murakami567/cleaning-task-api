def append_blocked_sync_alert(existing_note: str | None, title: str) -> str:
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    alert = (
        f"【Beds24同期 {timestamp}】\n"
        "予約タイトルがブロック対象へ変更されたためCXL\n"
        f"Title: {title}"
    )
    note = str(existing_note or "").strip()
    # Re-running sync must not duplicate the same alert endlessly.
    if note and "予約タイトルがブロック対象へ変更されたためCXL" in note and f"Title: {title}" in note:
        return note
    return f"{alert}\n\n{note}" if note else alert


def cancel_existing_blocked_task(booking_id: str, title: str) -> dict:
    """Do not create a task for a blocked Beds24 row. If the booking already
    has cleaning_tasks records, keep assignments/checker/history and mark them CXL.
    """
    booking_id = str(booking_id or "").strip()
    title = str(title or "").strip()
    if not booking_id:
        return {"matched": 0, "updated": 0, "task_ids": []}

    res = (
        supabase.table("cleaning_tasks")
        .select("*")
        .eq("booking_id", booking_id)
        .execute()
    )
    rows = res.data or []
    updated_ids = []

    for row in rows:
        row_id = row.get("id")
        if not row_id:
            continue
        update_payload = {
            "status": "CXL",
            "beds24_title": title,
            "note": append_blocked_sync_alert(row.get("note"), title),
        }
        supabase.table("cleaning_tasks").update(update_payload).eq("id", row_id).execute()
        updated_ids.append(row_id)

    return {"matched": len(rows), "updated": len(updated_ids), "task_ids": updated_ids}


